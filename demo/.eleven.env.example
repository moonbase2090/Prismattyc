# ElevenLabs credentials for the demo recorder.
# Copy this file to `.eleven.env` (same directory) and set your real key.
# `.eleven.env` is git-ignored and must never be committed.

export ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY_HERE"

# Optional: pin an exact voice id (skips name lookup; works without the
# voices_read permission). Otherwise the script resolves VOICE_NAME by name.
# export ELEVEN_VOICE_ID="YOUR_VOICE_ID_HERE"
