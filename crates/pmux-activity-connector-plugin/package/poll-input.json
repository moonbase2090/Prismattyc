{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "host": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "seat": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{1,64}:[0-9]+$",
      "maxLength": 85
    },
    "since_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 256
    }
  },
  "additionalProperties": false
}
