package pmux:plugin@1.0.0;

interface host {
    use pmux:view/frame@1.0.0.{clock};
    now: func() -> clock;
    asset: func(name: string) -> result<list<u8>, string>;
}

interface lifecycle {
    use pmux:view/frame@1.0.0.{viewport, preferences, event, content};
    use pmux:tool/call@1.0.0.{request, response};
    record capability { name: string, version: string, available: bool }
    record limits {
        memory-bytes: u64,
        result-bytes: u32,
        frame-bytes: u32,
    }
    record view-reference { id: u64, contribution: string, viewport: viewport, preferences: preferences }
    variant role { tool-service, view(view-reference) }
    record context {
        api-version: string,
        capabilities: list<capability>,
        limits: limits,
        role: role,
    }
    record view-event { id: u64, event: event }
    record view-frame { id: u64, content: content, next-tick-ms: u16 }
    variant message { start(context), tool(request), view(view-event), stop }
    variant reply { ready(string), tool(response), frame(view-frame), idle, closed }
}

world plugin {
    import pmux:activity/read@1.3.0;
    import host;
    use lifecycle.{message, reply};
    export handle: func(event: message) -> result<reply, string>;
}
