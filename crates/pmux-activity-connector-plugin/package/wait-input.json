{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["seat", "kinds", "timeout_ms"],
  "properties": {
    "host": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 64
    },
    "seat": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000
    }
  },
  "additionalProperties": false
}
