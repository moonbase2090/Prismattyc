# Build against the oldest supported GNU/Linux runtime.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates git python3 help2man \
    libfontconfig1-dev libxkbcommon-dev libxkbcommon-x11-0 libx11-dev \
    libxi-dev libxcursor-dev libxrandr-dev libxinerama-dev libwayland-dev \
    libegl1-mesa-dev libssl-dev xvfb xdotool fonts-dejavu-core \
    fonts-noto-color-emoji dbus-x11 at-spi2-core python3-pyatspi \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --default-toolchain 1.90.0
WORKDIR /src
