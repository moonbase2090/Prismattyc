package pmux:activity@1.3.0;

interface read {
    enum source { notify, hooks, runtime }
    enum kind {
        session-started, session-finished, turn-started, turn-finished,
        tool-started, tool-finished, tool-failed,
        command-started, command-finished, command-failed,
        edit-started, edit-finished, edit-failed,
        test-started, test-passed, test-failed,
        working, waiting, stopped, mail-sent, mail-received,
    }
    record detail {
        tool: option<string>,
        file: option<string>,
        command: option<string>,
        duration-ms: option<u64>,
        exit-code: option<s32>,
        task: option<string>,
        operation-id: option<string>,
        model: option<string>,
    }
    record input {
        schema-version: u16,
        seat: string,
        run-id: string,
        event-id: string,
        source: source,
        kind: kind,
        detail: option<detail>,
    }
    record activity-record {
        sequence: u64,
        received-at-ms: u64,
        event: input,
    }
    record cursor { epoch: string, sequence: u64 }
    enum reset { restarted, retention-gap, ahead-of-feed }
    enum session-state { working, waiting, idle, stuck, stopped }
    record session {
        seat: string,
        session-id: u64,
        state: session-state,
        last-output-at-ms: option<u64>,
        harness: option<string>,
        model: option<string>,
        quota: option<string>,
        project: option<string>,
    }
    record session-snapshot {
        observed-at-ms: u64,
        seats: list<session>,
    }
    record page {
        epoch: string,
        oldest-sequence: u64,
        current-sequence: u64,
        records: list<activity-record>,
        cursor: cursor,
        has-more: bool,
        reset: option<reset>,
    }
    enum error {
        not-activated, permission-denied, revoked, feed-disabled,
        unknown-endpoint, unreachable, rate-limited, invalid-request,
        incompatible-schema, interrupted, connecting,
    }
    enum endpoint-kind { local, socket, command }
    record endpoint { handle: u64, label: string, kind: endpoint-kind, min-interval-ms: u32 }
    sessions: func(endpoint: u64) -> result<option<session-snapshot>, error>;
    endpoints: func() -> result<list<endpoint>, error>;
    poll: func(endpoint: u64, after: option<cursor>, limit: u16) -> result<page, error>;
}

/// Mail and room arrivals, plus the wait used by newer readers.
/// Kept off `read` so an already published reader still links against that interface.
interface arrivals {
    use read.{error, source, reset};
    record detail {
        tool: option<string>,
        file: option<string>,
        command: option<string>,
        duration-ms: option<u64>,
        exit-code: option<s32>,
        task: option<string>,
        operation-id: option<string>,
        model: option<string>,
        sender-id: option<string>,
        room-id: option<string>,
        message-id: option<string>,
        count: option<u32>,
    }
    record notice {
        sequence: u64,
        received-at-ms: u64,
        schema-version: u16,
        seat: string,
        run-id: string,
        event-id: string,
        source: source,
        kind: string,
        detail: option<detail>,
    }
    record batch {
        epoch: string,
        oldest-sequence: u64,
        current-sequence: u64,
        cursor-sequence: u64,
        has-more: bool,
        reset: option<reset>,
        notices: list<notice>,
    }
    /// Blocks on the host until `seat` has an event of `kinds`, or `timeout-ms` elapses.
    /// `timeout-ms` is capped by the host. A match already in the feed returns on the first read.
    wait: func(endpoint: u64, seat: string, kinds: list<string>, timeout-ms: u32) -> result<batch, error>;
}

interface manage {
    /// Removes a session only when the daemon confirms none of its panes has a live child.
    enum removal { removed, live, missing }
    remove-stopped: func(endpoint: u64, session-id: u64) -> result<removal, string>;
}
