package pmux:activity@1.0.0;

interface read {
    enum source { notify, hooks, runtime }
    enum kind {
        session-started, session-finished, turn-started, turn-finished,
        tool-started, tool-finished, tool-failed,
        command-started, command-finished, command-failed,
        edit-started, edit-finished, edit-failed,
        test-started, test-passed, test-failed,
        working, waiting, stopped, mail-sent, mail-received,
    }
    record input {
        schema-version: u16,
        seat: string,
        run-id: string,
        event-id: string,
        source: source,
        kind: kind,
    }
    record activity-record {
        sequence: u64,
        received-at-ms: u64,
        event: input,
    }
    record cursor { epoch: string, sequence: u64 }
    enum reset { restarted, retention-gap, ahead-of-feed }
    record page {
        epoch: string,
        oldest-sequence: u64,
        current-sequence: u64,
        records: list<activity-record>,
        cursor: cursor,
        has-more: bool,
        reset: option<reset>,
    }
    enum error {
        not-activated, permission-denied, revoked, feed-disabled,
        unknown-endpoint, unreachable, rate-limited, invalid-request,
        incompatible-schema, interrupted,
    }
    record endpoint { handle: u64, label: string }
    endpoints: func() -> result<list<endpoint>, error>;
    poll: func(endpoint: u64, after: option<cursor>, limit: u16) -> result<page, error>;
}
