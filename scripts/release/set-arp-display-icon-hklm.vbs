Option Explicit

Dim data, parts, tempDir, sysRoot, ps, encoded, cmd, proc, rc, pid, fso, ts
data = ""
On Error Resume Next
data = Session.Property("CustomActionData")
On Error GoTo 0
data = Replace(data & "", Chr(34), "")

tempDir = ""
parts = Split(data, "|")
If UBound(parts) >= 2 Then
    tempDir = parts(2)
End If
If Len(tempDir) > 0 Then
    If Right(tempDir, 1) <> "\" Then
        tempDir = tempDir & "\"
    End If
End If

sysRoot = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%SystemRoot%")
ps = sysRoot & "\System32\WindowsPowerShell\v1.0\powershell.exe"
encoded = ""
cmd = Chr(34) & ps & Chr(34) & " -NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand " & encoded & " " & Chr(34) & "PRISMATTYC_ARP_DATA=" & data & Chr(34)

Set proc = GetObject("winmgmts:").Get("Win32_Process")
pid = 0
rc = proc.Create(cmd, Null, Null, pid)

If Len(tempDir) > 0 Then
    On Error Resume Next
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set ts = fso.OpenTextFile(tempDir & "prismattyc-displayicon.txt", 8, True)
    ts.WriteLine "spawned-hklm=" & CStr(rc)
    ts.Close
    On Error GoTo 0
End If
